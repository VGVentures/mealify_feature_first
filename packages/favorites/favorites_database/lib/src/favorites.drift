CREATE TABLE favorites (
    id TEXT NOT NULL PRIMARY KEY,
    meal_id TEXT NOT NULL,
    drink_id TEXT NOT NULL,
    created_at DATETIME NOT NULL,

    UNIQUE(meal_id, drink_id)
);

findFavoriteById: 
    SELECT * FROM favorites WHERE id = :favoriteId;

findAllFavoriteIds:
    SELECT id FROM favorites ORDER BY created_at DESC;

deleteFavoriteById:
    DELETE FROM favorites WHERE id = :favoriteId;

deleteFavoriteByMealAndDrink:
    DELETE FROM favorites WHERE meal_id = :mealId AND drink_id = :drinkId;

isFavorite:
    SELECT EXISTS(
        SELECT 1 FROM favorites
        WHERE meal_id = :mealId AND drink_id = :drinkId
    );